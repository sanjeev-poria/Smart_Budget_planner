# SMARTFIN Backend Environment Configuration
PROJECT_NAME="SMARTFIN - AI-Powered Personal Financial Management System"
ENVIRONMENT="development"
HOST="0.0.0.0"
PORT=8000
API_V1_STR="/api/v1"

# CORS Origins (JSON list format or comma-separated)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# MongoDB Configuration (Local or MongoDB Atlas srv URL)
# For local: mongodb://localhost:27017
# For Atlas: mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
MONGODB_URL="mongodb://localhost:27017"
MONGODB_DB_NAME="smartfin_db"

# Security & JWT Authentication
JWT_SECRET_KEY="smartfin_development_jwt_secret_key_change_in_production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google Gemini API Configuration
GEMINI_API_KEY=""
